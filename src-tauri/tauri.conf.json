{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Udaan",
  "version": "0.1.0",
  "identifier": "dev.udaan.workstation",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "title": "Udaan",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "transparent": false,
        "decorations": false,
        "backgroundColor": "#0b0f16"
      },
      {
        "label": "taskbar",
        "title": "Udaan Taskbar",
        "url": "index.html?window=taskbar",
        "width": 760,
        "height": 76,
        "resizable": false,
        "fullscreen": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/piper": "resources/piper",
      "resources/voices": "resources/voices"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
