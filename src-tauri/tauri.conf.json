{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Udaan",
  "version": "0.1.0",
  "identifier": "dev.udaan.workstation",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "title": "Udaan",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "transparent": false,
        "decorations": false,
        "backgroundColor": "#0b0f16",
        "visible": false
      },
      {
        "label": "taskbar",
        "title": "Udaan Taskbar",
        "url": "index.html?window=taskbar",
        "width": 960,
        "height": 104,
        "resizable": false,
        "fullscreen": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false
      },
      {
        "label": "taskbar-popup",
        "title": "Udaan Taskbar Popup",
        "url": "index.html?window=taskbar-popup",
        "width": 1,
        "height": 1,
        "resizable": false,
        "fullscreen": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost https://demotiles.maplibre.org; media-src 'self' data: asset: http://asset.localhost; font-src 'self' data:; connect-src 'self' http://localhost:20128 https://demotiles.maplibre.org https://api.open-meteo.com https://raw.githubusercontent.com https://tonejs.github.io asset: http://asset.localhost; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/piper": "resources/piper",
      "resources/voices": "resources/voices"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
