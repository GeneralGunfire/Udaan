{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Udaan",
  "version": "0.1.0",
  "identifier": "dev.udaan.workstation",
  "build": {
    "beforeDevCommand": "node scripts/build-watchdog.mjs && pnpm dev",
    "beforeBuildCommand": "node scripts/build-watchdog.mjs && pnpm build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "title": "Udaan Desktop",
        "width": 1440,
        "height": 900,
        "resizable": false,
        "skipTaskbar": true,
        "shadow": false,
        "fullscreen": false,
        "transparent": false,
        "decorations": false,
        "create": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --renderer-process-limit=2",
        "backgroundColor": "#0b0f16",
        "visible": false
      },
      {
        "label": "taskbar",
        "title": "Udaan Dock",
        "url": "index.html?window=taskbar",
        "width": 1200,
        "height": 120,
        "resizable": false,
        "fullscreen": false,
        "transparent": true,
        "decorations": false,
        "create": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --renderer-process-limit=2",
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false
      },
      {
        "label": "taskbar-popup",
        "title": "Udaan Taskbar Popup",
        "url": "index.html?window=taskbar-popup",
        "width": 1,
        "height": 1,
        "resizable": false,
        "fullscreen": false,
        "transparent": true,
        "decorations": false,
        "create": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --renderer-process-limit=2",
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false,
        "focus": false
      },
      {
        "label": "launcher",
        "title": "Udaan Launcher",
        "url": "index.html?window=launcher",
        "width": 1280,
        "height": 800,
        "resizable": false,
        "fullscreen": false,
        "transparent": true,
        "decorations": false,
        "create": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --renderer-process-limit=2",
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false
      },
      {
        "label": "toast",
        "title": "Udaan Notifications",
        "url": "index.html?window=toast",
        "width": 380,
        "height": 120,
        "resizable": false,
        "fullscreen": false,
        "transparent": true,
        "decorations": false,
        "create": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --renderer-process-limit=2",
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false,
        "focus": false
      },
      {
        "label": "edgelight",
        "title": "Udaan Edge Light",
        "url": "index.html?window=edgelight",
        "width": 800,
        "height": 600,
        "resizable": false,
        "fullscreen": false,
        "transparent": true,
        "decorations": false,
        "create": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --renderer-process-limit=2",
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false,
        "focus": false
      },
      {
        "label": "menubar",
        "title": "Udaan Menu Bar",
        "url": "index.html?window=menubar",
        "width": 1280,
        "height": 30,
        "resizable": false,
        "fullscreen": false,
        "transparent": true,
        "decorations": false,
        "create": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --renderer-process-limit=2",
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: asset: http://asset.localhost; media-src 'self' data: blob: asset: http://asset.localhost https://*.itunes.apple.com https://*.apple.com https://*.mzstatic.com; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://localhost:20128 https://api.open-meteo.com https://raw.githubusercontent.com https://tonejs.github.io asset: http://asset.localhost; frame-src http://127.0.0.1:*; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/piper": "resources/piper",
      "resources/voices": "resources/voices"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "externalBin": [
      "binaries/shell-watchdog"
    ]
  },
  "mainBinaryName": "Udaan"
}